@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/bacnet/2024> a owl:Ontology ;
    rdfs:label "BACnet Ontology translated from CSML files"@en ;
    dcterms:title "BACnet Ontology"@en ;
    dcterms:description """Classes and SHACL shapes for validating BACnet content encoded in RDF. The definitions of the BACnet base types and object types are generated by csml2rdf from the CSML published by ASHRAE for ANSI/ASHRAE Standard 135-2024."""@en ;
    rdfs:comment "Generated file: change the CSML sources or csml2rdf rather than editing the definitions by hand."@en ;
    dcterms:creator "ASHRAE SSPC 135 Data Modeling Working Group" ;
    dcterms:source <https://data.ashrae.org/bacnet/XD/latest/> ;
    dcterms:created "2026-11-16"^^xsd:date ;
    rdfs:seeAlso <https://github.com/gtfierro/csml2rdf> ;
    vann:preferredNamespacePrefix "bacnet" ;
    vann:preferredNamespaceUri "http://data.ashrae.org/bacnet/2024#" .
