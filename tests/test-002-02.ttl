@prefix bacnet: <http://data.ashrae.org/bacnet/2024#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bacnet:TestSequence.Action a rdfs:Class ;
    rdfs:label "TestSequence.Action" ;
    bacnet:memberClass bacnet:TestSequence.ActionEnumerationValue ;
    rdfs:subClassOf bacnet:EnumerationKind .

bacnet:TestSequence.ActionEnumerationValue a rdfs:Class ;
    rdfs:label "TestSequence.ActionEnumerationValue" ;
    rdfs:subClassOf bacnet:EnumerationValue .

bacnet:TestSequence a sh:NodeShape ;
    rdfs:label "TestSequence" ;
    rdfs:subClassOf bacnet:Sequence ;
    sh:property [ a sh:PropertyShape ;
            sh:class bacnet:TestSequence.ActionEnumerationValue ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bacnet:action ] .

bacnet:TestSequence.Action.direct a bacnet:TestSequence.ActionEnumerationValue ;
    bacnet:name "direct" ;
    bacnet:value "0"^^xsd:nonNegativeInteger .

bacnet:TestSequence.Action.reverse a bacnet:TestSequence.ActionEnumerationValue ;
    bacnet:name "reverse" ;
    bacnet:value "1"^^xsd:nonNegativeInteger .

